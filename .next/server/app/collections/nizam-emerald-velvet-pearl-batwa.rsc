9:["$","$L14",null,{"product":{"id":"aln-potli-02","slug":"nizam-emerald-velvet-pearl-batwa","name":"Nizam Emerald Velvet Pearl-Beaded Wedding Batwa","category":"Luxury Bridal Potlis","collection":"Heirloom Silverware & Bridal Accessories","tagline":"Deep royal emerald green velvet adorned with micro-pearl lattice and Kundan brooch","description":"A regal evening batwa crafted in deep emerald green velvet. Covered with a geometric lattice of hand-strung ivory pearls and centered by an ornamental Kundan jewel clasp. The handle features a double strand of seed pearls with a secure magnetic snap.","details":["Rich bottle-green velvet with dense pearl net embroidery","Ornamental Kundan jewel medallion on front face","Dual pearl-strand wristlet handle for effortless carriage","Ideal for wedding receptions, sangeets, and festive soirees"],"indicativePrice":24000,"priceNote":"Indicative Price* — Handcrafted limited edition.","images":["https://images.unsplash.com/photo-1544816155-12df9643f363?q=80&w=1200&auto=format&fit=crop","https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=1200&auto=format&fit=crop"],"featured":false,"bestseller":true,"sku":"ALN-PT-002","availability":"In Store","specifications":{"metal":"24K gold-plated brass brooch frame","purity":"Artisanal Hand-Embroidered Velvet","gemstones":"Lustrous ivory pearls and Jadau-style glass stones","dimensions":"Height: 8.0 inches; Width: 6.0 inches; Pearl Handle Drop: 6.5 inches","closure":"Drawstring with matching pearl latkans","craftsmanship":"Hyderabadi pearl-stringing and velvet hand-embroidery","certification":"Alankar Luxury Boutique Certified Heirloom Tag"}}}]
