9:["$","$L14",null,{"product":{"id":"aln-shring-01","slug":"noor-mahal-kundan-mathapatti-passa","name":"Noor Mahal Royal Kundan Mathapatti & Passa Set","category":"Bridal Shringar","collection":"The Royal Polki & Jadau Heritage","tagline":"Grand bridal forehead shringar: Dual-strand Mathapatti with crescent Passa","description":"The crowning glory of royal Indian brides. Hand-wrought in 22K gold with uncut Jadau stones, carved emerald beads, and cascading seed pearls. Designed to frame the bride's hairline gracefully with a coordinating side crescent Passa (Jhoomar).","details":["Complete bridal hair ensemble: Dual-tier Mathapatti + Side Crescent Passa","Cascading natural seed pearls and green enamel drops","Multiple concealed hairpin loops for secure, lightweight wearing","Handcrafted using 24K gold Jadau foiling"],"indicativePrice":420000,"priceNote":"Indicative Price* — Complete matching 2-piece set.","images":["https://images.unsplash.com/photo-1601121141461-9d6647bca1ed?q=80&w=1200&auto=format&fit=crop","https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1200&auto=format&fit=crop"],"featured":true,"bestseller":true,"sku":"ALN-SH-001","availability":"In Store","specifications":{"metal":"22K Hallmarked Yellow Gold (916)","purity":"22K Gold with 24K Jadau Inlay","gemstones":"Natural Polki Stones, Natural Emerald Beads (18.50 cts), Seed Pearls (22.00 cts)","grossWeight":"92.40 grams","netWeight":"64.80 grams","closure":"Handwoven gold silk loop ties and safety hair combs","dimensions":"Headband Length: 11 inches each side; Center Tikka Drop: 6.5 cm; Passa: 9.5 cm","craftsmanship":"Master Jadau & Gulabi Meenakari from Jaipur","certification":"BIS 916 Hallmarked with authenticity certification"}}}]
