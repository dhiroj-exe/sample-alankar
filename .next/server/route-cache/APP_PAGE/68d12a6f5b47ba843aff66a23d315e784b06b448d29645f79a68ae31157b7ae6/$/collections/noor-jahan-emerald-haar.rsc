9:["$","$L14",null,{"product":{"id":"aln-neck-02","slug":"noor-jahan-emerald-haar","name":"Noor Jahan Tiered Emerald & Gold Haar","category":"Necklaces","collection":"Nizam Emerald & Ruby Symphony","tagline":"Seven cascading strands of luminous Columbian emerald fluted beads and 22K gold","description":"A regal maharani haar designed with seven graduated strands of hand-selected fluted Columbian emeralds, anchored by twin 22K yellow gold floral filigree spacers. The magnificent central medallion features a 14-carat cabochon emerald surrounded by untreated rubies and south-sea pearl drops.","details":["Seven cascading tiers of natural fluted emerald beads","Twin 22K gold filigree floral side brooches","Central oval cabochon emerald with micro-kundan pearl halo","Custom luxury velvet presentation coffret"],"indicativePrice":1150000,"priceNote":"Indicative Price* — Available for private store viewing.","images":["https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?q=80&w=1200&auto=format&fit=crop","https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1200&auto=format&fit=crop","https://images.unsplash.com/photo-1535632066927-ab7c9ab60908?q=80&w=1200&auto=format&fit=crop"],"featured":true,"bestseller":false,"sku":"ALN-NK-002","availability":"Artisanal Limited","specifications":{"metal":"22K Hallmarked Yellow Gold (916)","purity":"22K Fine Pure Gold","gemstones":"Fluted Emerald Beads (142.50 cts), Center Cabochon Emerald (14.20 cts), Natural Burma Rubies (8.40 cts)","grossWeight":"162.20 grams","netWeight":"78.40 grams","closure":"22K Yellow Gold dual-safety handmade hook clasp","dimensions":"Longest Tier: 28 inches; Medallion: 5.5 cm x 4.2 cm","craftsmanship":"Traditional threading with pure silk cord and 22K gold beads","certification":"BIS 916 Hallmark with Gemstone Origin Dossier"}}}]
