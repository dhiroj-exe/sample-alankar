9:["$","$L14",null,{"product":{"id":"aln-silv-01","slug":"imperial-silver-pooja-thali-royal-suite","name":"Imperial 92.5 Sterling Silver Pooja Thali Suite","category":"Silver & Pooja Heirlooms","collection":"Heirloom Silverware & Bridal Accessories","tagline":"Auspicious 7-piece Nakashi silver pooja suite in pure 92.5 sterling silver","description":"An auspicious heirloom crafted in certified 92.5 pure sterling silver for traditional Indian homes and auspicious wedding poojas. The grand central thali is engraved with the Ashtalakshmi motifs, accompanied by a carved Panchapatra with spoon, Mayura silver bell (Ghanti), twin Nakashi Kamakshi diyas, and a silver Kumkum bharani.","details":["Complete 7-Piece Auspicious Set: Grand 12-inch Thali, Twin Diyas, Panchapatra & Spoon, Ghanti, Agarbatti Holder & Kumkum Bharani","Deep high-relief Ashtalakshmi and floral border chiselling","100% Solid 92.5 Sterling Silver throughout (No hollow filling)","Presented in an archival velvet-lined wooden heirloom trunk"],"indicativePrice":185000,"priceNote":"Indicative Price* — Based on silver bullion weight (Approx. 1.25 kg).","images":["https://images.unsplash.com/photo-1615655406736-b37c4fabf923?q=80&w=1200&auto=format&fit=crop","https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1200&auto=format&fit=crop"],"featured":true,"bestseller":true,"sku":"ALN-SV-001","availability":"In Store","specifications":{"metal":"92.5 Pure Sterling Silver","purity":"92.5% Fine Silver (Hallmarked 925)","grossWeight":"1,280 grams (Total Set Weight)","netWeight":"1,280 grams pure sterling silver","dimensions":"Thali Diameter: 12.5 inches; Diya Height: 4.8 inches","craftsmanship":"Hand-chiselled Nakashi by generational silversmiths","certification":"Bureau of Indian Standards (BIS) 925 Sterling Silver Hallmark"}}}]
