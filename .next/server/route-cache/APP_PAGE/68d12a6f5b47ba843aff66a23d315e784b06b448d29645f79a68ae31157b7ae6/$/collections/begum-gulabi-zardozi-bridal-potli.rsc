9:["$","$L14",null,{"product":{"id":"aln-potli-01","slug":"begum-gulabi-zardozi-bridal-potli","name":"Begum Gulabi Handcrafted Zardozi Bridal Potli","category":"Luxury Bridal Potlis","collection":"Heirloom Silverware & Bridal Accessories","tagline":"Hand-embroidered gold metallic Zardozi, real pearls and rose velvet batwa","description":"An opulent bridal accessory designed to accompany Indian royal bridal wear. Handcrafted in our signature Rose Pink velvet, embellished with raised 24K gold-plated metallic wire (Zardozi), natural seed pearls, and semi-precious ruby florets, finished with braided silk drawstrings and heavy golden latkans.","details":["Pure silk velvet base in Alankar signature Rose Pink","Ancestral Zardozi & Dabka embroidery by master Lucknow artisans","Braided silk drawstring with hand-wrapped pearl latkans","Spacious satin-lined interior fitting smartphones and wedding essentials"],"indicativePrice":28000,"priceNote":"Indicative Price* — Bespoke monogramming available.","images":["https://images.unsplash.com/photo-1544816155-12df9643f363?q=80&w=1200&auto=format&fit=crop","https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?q=80&w=1200&auto=format&fit=crop"],"featured":true,"bestseller":true,"sku":"ALN-PT-001","availability":"In Store","specifications":{"metal":"Gold-plated metallic Zari wire & brass latkan cores","purity":"Handmade Luxury Bridal Accessory","gemstones":"Cultured seed pearls & ruby-red faceted stones","dimensions":"Height: 8.5 inches; Base Diameter: 5.5 inches; Handle Drop: 7 inches","closure":"Handwoven silk drawstring with weighted ornamental tassels","craftsmanship":"Authentic Awadhi Zardozi and Dabka embroidery","certification":"Alankar Luxury Certified Handcrafted Atelier Tag"}}}]
